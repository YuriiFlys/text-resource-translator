# PostgreSQL (одна база для i18n_* і схеми rag)
PG_DSN=postgresql+psycopg://trt:trt@localhost:5432/trt

# Локалізація
SOURCE_LOCALE=en

# Вкладення
EMBEDDING_PROVIDER=huggingface          # huggingface | openai
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768                        # має збігатися з типом колонки rag.chunk.embedding

# LLM
LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# Сховище оригіналів
RAW_DIR=./data/raw

# Планувальник
INTERVAL_MINUTES=30

LOG_LEVEL=INFO
