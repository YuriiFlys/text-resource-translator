# PostgreSQL (одна база для i18n_* і схеми rag)
PG_DSN=postgresql+psycopg://trt:trt@localhost:5432/trt

# Локалізація
SOURCE_LOCALE=en

# Вкладення
EMBEDDING_PROVIDER=huggingface          # huggingface | openai | hashing (локальна без моделей, для тестів/демо)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768                        # має збігатися з типом колонки rag.chunk.embedding

# LLM (локальна Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
TRANSLATION_BATCH_SIZE=20
TRANSLATION_MAX_RETRIES=1
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# Сховище оригіналів
RAW_DIR=./data/raw

# Планувальник
INTERVAL_MINUTES=30

LOG_LEVEL=INFO
